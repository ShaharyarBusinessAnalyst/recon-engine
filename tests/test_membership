import random

import pandas as pd
import pytest

from data_gen.contracts import make_contracts
from data_gen.hospitals import make_customers, make_hospitals, make_memberships
from data_gen.membership import make_affiliations, make_tier_assignments
from data_gen.reference import make_gpo
from data_gen.settings import GenSettings

GPO_IDS = ["GPO01", "GPO02", "GPO03", "GPO04"]


@pytest.fixture(scope="module")
def generated() -> dict[str, pd.DataFrame]:
    settings = GenSettings()
    rng = random.Random(settings.seed)
    contracts = make_contracts(rng, make_gpo(), settings)
    hospitals = make_hospitals(rng, settings)
    memberships = make_memberships(rng, hospitals, GPO_IDS, settings)
    _, customer_labels = make_customers(rng, hospitals)
    affiliations, _ = make_affiliations(rng, memberships, customer_labels)
    tiers, short_notice = make_tier_assignments(
        rng, memberships, contracts, customer_labels, settings
    )
    return {"affiliations": affiliations, "tiers": tiers, "short_notice": short_notice}


def test_tier_periods_never_overlap(generated: dict[str, pd.DataFrame]) -> None:
    tiers = generated["tiers"].sort_values(["customer_id", "contract_id", "effective_from"])
    for _, group in tiers.groupby(["customer_id", "contract_id"]):
        rows = group.to_dict("records")
        for earlier, later in zip(rows, rows[1:], strict=False):
            assert earlier["effective_to"] <= later["effective_from"]


def test_reviews_give_90_days_notice_unless_planted(generated: dict[str, pd.DataFrame]) -> None:
    reviews = generated["tiers"][generated["tiers"]["reason"] == "quarterly_review"]
    planted = set(generated["short_notice"]["tier_assignment_id"])
    for row in reviews.to_dict("records"):
        days = (row["effective_from"] - row["notice_date"]).days
        if row["tier_assignment_id"] in planted:
            assert days < 90
        else:
            assert days >= 90


def test_some_affiliations_are_unconfirmed_guesses(generated: dict[str, pd.DataFrame]) -> None:
    """Without unconfirmed multi-GPO cases, E12 and A1 could never be tested."""
    assert (~generated["affiliations"]["confirmed_by_customer"]).any()
